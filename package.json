{
  "name": "yunji-tab",
  "displayName": "Yunji Tab",
  "version": "0.1.0",
  "description": "A minimal yet powerful new-tab bookmark workspace: 2-way native sync, categorized dashboard, fast search, tags, pin, bulk management, and link health check.",
  "author": "KIWI",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e --quiet",
    "test": "vitest run src",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@plasmohq/storage": "^1.15.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "plasmo": "0.90.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tldts": "^7.4.8",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint-react/eslint-plugin": "^5.13.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "0.2.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "postcss": "^8.5.16",
    "prettier": "3.9.5",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "zh_CN",
    "permissions": [
      "storage",
      "bookmarks",
      "search",
      "favicon",
      "activeTab",
      "scripting",
      "contextMenus",
      "tabs"
    ],
    "host_permissions": [
      "https://www.google.com/*",
      "https://*.gstatic.com/*"
    ],
    "optional_host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "commands": {
      "open-global-command-palette": {
        "description": "__MSG_openGlobalCommandPaletteDescription__"
      },
      "quick-save-page": {
        "suggested_key": {
          "default": "Alt+Shift+B",
          "mac": "Command+Shift+B"
        },
        "description": "__MSG_quickSaveCommandDescription__"
      }
    },
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/global-command-palette.html"
        ],
        "matches": [
          "http://*/*",
          "https://*/*"
        ]
      }
    ]
  }
}
